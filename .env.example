# Скопируйте в .env. Для compose хосты — имена сервисов.
VAS_ENV=local
VAS_LOG_JSON=true
VAS_DB_URL=postgresql+asyncpg://postgres:postgres@db:5432/vas
VAS_REDIS_URL=redis://redis:6379/0
VAS_BROKER_URL=redis://broker:6379/0

# Секреты. В проде — из хранилища секретов CI, не из файла в репозитории.
VAS_JWT_KEY=change-me-to-32-random-bytes-please
VAS_CODE_PEPPER=change-me-too
VAS_INTERNAL_KEY=change-me-internal

VAS_ACQUIRER_URL=http://fakes:8090/acquirer
VAS_ACQUIRER_SHOP=shop-local
VAS_ACQUIRER_KEY=acquirer-local-key
VAS_ACQUIRER_HOOK_SECRET=acquirer-local-hook
VAS_RETURN_URL=http://localhost:8000/paid

VAS_PANEL_URL=http://fakes:8090/panel
VAS_PANEL_KEY=panel-local-key

# Почта уходит в fakes: письма можно посмотреть на http://localhost:8090/mail/last?to=...
VAS_EMAIL_API=http://fakes:8090/mail/send
VAS_EMAIL_KEY=mail-local-key

# Необязательные: без них уведомления и аналитика пишутся в лог
# VAS_BOT_TOKEN=
# VAS_FCM_PROJECT=
# VAS_FCM_TOKEN=
# VAS_CLICKHOUSE_URL=http://clickhouse:8123

# Хаос для fakes_upstream
# FAKE_PANEL_ERRORS=0.3
# FAKE_PANEL_DELAY_MS=800
# FAKE_DECLINE_CARDS=1
